---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { SEO, SITE_URL } from '../data/site'
import { productDetailJsonLd } from '../lib/seo'
import { getGame } from '../data/games'
import { PAGE_MEDIA } from '../data/media'

const game = getGame('isle')
const jsonLdExtra = [
  productDetailJsonLd(game?.status ?? 'Updating'),
  {
    '@type': 'VideoObject',
    name: PAGE_MEDIA.product.videoTitle,
    description: PAGE_MEDIA.product.videoDescription,
    thumbnailUrl: `${SITE_URL}${PAGE_MEDIA.product.image}`,
    contentUrl: `${SITE_URL}${PAGE_MEDIA.product.video}`,
    uploadDate: '2026-09-15',
    duration: 'PT8S',
    isFamilyFriendly: false,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'The Isle Cheats',
        item: `${SITE_URL}/isle-cheats`,
      },
    ],
  },
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra}>
  <GameProductPage client:idle guideSlug="isle-cheats" />
</BaseLayout>


